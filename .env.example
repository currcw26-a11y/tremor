# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so your real keys never get committed.
# Fake values below are just placeholders.

# --- Contact (sent in the User-Agent header to SEC and job boards, as they require) ---
CONTACT_EMAIL=you@example.com

# --- Supabase (database + Google login) — Week 1 ---
SUPABASE_URL=https://your-project-id.supabase.co
# Public, safe for the website: the "Publishable key" (starts with sb_publishable_).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_goes-here
# Secret! Supabase → Project Settings → API Keys → "Secret keys" (starts with sb_secret_).
# Only the pipeline uses this. Never put it in the website's browser code.
SUPABASE_SECRET_KEY=sb_secret_goes-here

# --- Claude API — Week 2 ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Monthly AI spending cap in US dollars
AI_MONTHLY_BUDGET_USD=15

# --- Email (Resend) — Week 3 ---
RESEND_API_KEY=re_your-key-here

# --- Price data & FDA — Week 4 ---
FMP_API_KEY=your-fmp-key
MASSIVE_API_KEY=your-massive-key
OPENFDA_API_KEY=your-openfda-key
